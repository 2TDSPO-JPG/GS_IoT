# A ponte usa apenas o computador local por padrão.
HOST=127.0.0.1
PORT=8090

# Use somente dados de simulação no broker público.
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=saneia/demo/72f4a1ce9b/res07/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=

IOT_DATA_FILE=data/telemetry.json
IOT_DEMO_TOKEN=
IOT_WEB_ORIGIN=

GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# Credencial do Spring AI para o serviço RAG. Use pelo menos 32 bytes.
RAG_INTEGRATION_TOKEN=
RAG_HOST=127.0.0.1
RAG_PORT=8091
